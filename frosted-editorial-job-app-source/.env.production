# Used by src/lib/api.ts at build time. The production build (a standalone
# Node server) isn't behind vite dev's /api proxy, so it needs an absolute
# URL for the FastAPI backend. Override at build time if the backend runs
# somewhere else: VITE_API_BASE=https://... npm run build
VITE_API_BASE=http://127.0.0.1:8123
